# Reads /dev/tty because git feeds the pushed-ref list to a pre-push hook on stdin.
PROD_BRANCH=main
DUMP_BRANCH=staging
ZERO_SHA=0000000000000000000000000000000000000000
push_to_prod= push_to_dump_branch= sha_from= sha_to=
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/$PROD_BRANCH" ]; then
    push_to_prod=1; sha_from=$remote_sha; sha_to=$local_sha
  fi
  if [ "$remote_ref" = "refs/heads/$DUMP_BRANCH" ] && [ "$local_sha" != "$ZERO_SHA" ]; then
    push_to_dump_branch=1
  fi
done

if [ -n "$push_to_prod" ]; then
  if [ "$sha_from" = "$ZERO_SHA" ]; then
    sha_from=$(git hash-object -t tree /dev/null)   # new branch: diff vs empty tree
  fi
  # --diff-filter=A: only ADDED migrations are pending applies.
  added=$(git diff --name-only --diff-filter=A "$sha_from" "$sha_to" -- src/migrations/ | grep '\.ts$' || true)
  if [ -n "$added" ]; then
    # Only up() counts — nearly every down() drops.
    after_deploy=$(for f in $added; do
      src=$(git show "$sha_to:$f")
      if echo "$src" | grep -q 'RUN-AFTER-DEPLOY' \
        || echo "$src" | awk '/function up/{u=1} /function down/{u=0} u' | grep -Eiq 'DROP (COLUMN|TABLE)'; then
        echo "     $f"
      fi
    done)
    if { : < /dev/tty; } 2>/dev/null; then
      if [ -n "$after_deploy" ]; then
        printf '\n⚠  Push to %s adds migrations that must run AFTER this deploy is live:\n%s\n   Push now, then run `pnpm db:migrate:prod` (backup-first) once the deploy serves traffic.\n   If this push also adds a migration the new code needs FIRST, abort and split the release.\n   Push the code now? [y/N] ' "$PROD_BRANCH" "$after_deploy" > /dev/tty
        abort_hint="split the release, then push"
      else
        printf '\n⚠  Push to %s adds new src/migrations/.\n   Prod is NOT auto-migrated. Run `pnpm db:migrate:prod` yourself (backup-first)\n   BEFORE this deploy serves traffic, else the live app runs against an old schema.\n   Push the code now anyway? [y/N] ' "$PROD_BRANCH" > /dev/tty
        abort_hint="migrate prod first, then push"
      fi
      read -r go < /dev/tty || go=n
      case "$go" in
        [Yy]*) echo "→ pushing code; remember to run pnpm db:migrate:prod" >&2 ;;
        *)     echo "✗ aborted — $abort_hint" >&2; exit 1 ;;
      esac
    else
      echo "→ no terminal to confirm; pushing code only (migrate prod manually)" >&2
    fi
  fi
fi

bash scripts/with-test-lock.sh bash scripts/pre-push-tests.sh || exit 1

dump_go=n
if [ -n "$push_to_dump_branch" ]; then
  if { : < /dev/tty; } 2>/dev/null; then
    printf '\nDump the production DB from Neon before pushing to %s? [y/N] ' "$DUMP_BRANCH" > /dev/tty
    read -r dump_go < /dev/tty || dump_go=n
  else
    echo "→ no terminal to confirm; skipping DB dump" >&2
  fi
fi

case "$dump_go" in [Yy]*)
  echo "Dumping production DB from Neon..."
  if pnpm db:dump && [ -s dumps/dump-latest.sql ]; then
    echo "✅ DB dump succeeded ($(du -h dumps/dump-latest.sql | cut -f1))"
  else
    echo "❌ DB dump failed or produced empty file"
    exit 1
  fi

  echo "Pruning dumps older than 7 days..."
  pruned=$(find dumps -name 'dump-*.sql' ! -name 'dump-latest.sql' -mtime +7 -print -delete 2>/dev/null | wc -l | tr -d ' ')
  echo "✅ Pruned ${pruned:-0} old dump(s)"
  ;;
esac

# Detached subshell so `git push` returns immediately when the hook exits.
# never block a push over LOCAL auth
if [ -z "${SKIP_WATCH_DEPLOY:-}" ]; then
  if bash scripts/watch-deploy.sh --check-auth; then
    ( DEPLOY_SHA="$(git rev-parse HEAD)" bash scripts/watch-deploy.sh & )
  else
    echo "  🔒 vercel: skipping deploy watcher — fix local CLI auth (see above), then push again to tail." >&2
  fi
fi
